{
  "name": "keyvalet",
  "version": "0.1.0",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "templates:import": "node scripts/import-n8n-templates.mjs",
    "templates:build": "node scripts/build-catalog.mjs"
  },
  "author": "Guang",
  "license": "Apache-2.0",
  "description": "Give your AI agents a valet key, not your master key. A local credential broker for AI agents (MCP) on macOS.",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "credentials",
    "secrets",
    "oauth",
    "touch-id",
    "macos",
    "claude"
  ]
}
